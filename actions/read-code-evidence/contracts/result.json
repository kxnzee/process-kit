{
  "type": "object",
  "required": [
    "selectionId",
    "records",
    "queryFile"
  ],
  "properties": {
    "selectionId": {
      "type": "string",
      "minLength": 1
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "prs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "state"
              ],
              "properties": {
                "state": {
                  "type": "string",
                  "enum": [
                    "MERGED",
                    "OPEN",
                    "DECLINED",
                    "SUPERSEDED"
                  ]
                },
                "changedPaths": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "id": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "integer",
                      "minimum": 0
                    }
                  ]
                },
                "url": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": true
            }
          },
          "prsComplete": {
            "type": "boolean"
          },
          "commit": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "queryFile": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
