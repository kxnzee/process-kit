#!/bin/sh
# Защита общего репозитория от разрушающей отправки.
# Что запрещено в общий адрес: личная ветка my, служебные заметки refs/notes/*,
# принудительная перезапись (--force, --force-with-lease, +refspec) и удаление веток.
# В собственный репозиторий (mine) отправка разрешена. Другие ветки не трогаем.
# Ставится копией в .git/hooks/pre-push; сам файл hook в репозиторий не попадает.
set -e

common=$(git config "branch.my.pushRemote" || true)
[ -n "$common" ] || common=origin
[ "$common" = "no_push" ] && common=origin

# Отправка в собственный репозиторий (mine) разрешена; защищаем общий адрес, а не любой.
own=$(git config --get "remote.mine.url" || true)
if [ -n "$own" ] && [ "$2" = "$own" ] && [ "$common" = "mine" ]; then
  exit 0
fi

# Перезапись истории: git push --force / --force-with-lease / --mirror / +ветка.
forced=''
case "$*" in
  *--force*) forced=1 ;;
  *--mirror*) forced=1 ;;
  *"+refs/"*) forced=1 ;;
esac

while read -r local_ref local_sha remote_ref remote_sha; do
  # Удаление ветки: пустой sha и непустой прежний — git push <адрес> --delete <ветка>.
  if [ "$local_sha" = "0000000000000000000000000000000000000000" ] && [ "$remote_sha" != "0000000000000000000000000000000000000000" ]; then
    echo "Удаление ветки в общем репозитории запрещено: $remote_ref." >&2
    echo "Ветку на сервере удаляют правилами репозитория, а не отправкой из рабочей папки." >&2
    exit 1
  fi

  case "$remote_ref" in
    refs/notes/*)
      echo "Служебные заметки GigaCode ($remote_ref) в $2 (общий репозиторий) не отправляются." >&2
      echo "Они ни на что не влияют и остаются на вашем компьютере." >&2
      exit 1
      ;;
  esac

  branch=${local_ref#refs/heads/}
  if [ "$branch" = "my" ] && [ "$remote_ref" = "refs/heads/my" ]; then
    echo "Личную копию нельзя отправить в общий репозиторий." >&2
    echo "Ветка my — ваша: в $2 (общий репозиторий) она не отправляется." >&2
    echo "Ваши личные файлы остаются на вашем компьютере; общий репозиторий их не получает." >&2
    echo "Если нужен собственный репозиторий — укажите его адрес при настройке, отправка туда разрешена." >&2
    exit 1
  fi
done

if [ -n "$forced" ]; then
  echo "Принудительная отправка в общий репозиторий запрещена ($*)." >&2
  echo "Она перезаписывает чужую работу на сервере." >&2
  echo "Отправляйте без перезаписи: git push $2 <ветка>." >&2
  exit 1
fi

exit 0