{
  "mcpServers": {
    "rk-confluence": {
      "type": "streamable-http",
      "httpUrl": "https://api.sbertrack.sberbank.ru/confluence/mcp",
      "headers": {
        "x-confluence-token": "$secret:rk-confluence/x-confluence-token"
      }
    },
    "rk-confluence-delta": {
      "type": "streamable-http",
      "httpUrl": "https://api.sbertrack.sberbank.ru/confluence/delta/mcp",
      "headers": {
        "x-confluence-token": "$secret:rk-confluence-delta/x-confluence-token"
      }
    },
    "rk-jira": {
      "type": "streamable-http",
      "httpUrl": "https://api.sbertrack.sberbank.ru/jira/mcp",
      "headers": {
        "x-jira-token": "$secret:rk-jira/x-jira-token"
      }
    },
    "rk-jira-delta": {
      "type": "streamable-http",
      "httpUrl": "https://api.sbertrack.sberbank.ru/jira/delta/mcp",
      "headers": {
        "x-jira-token": "$secret:rk-jira-delta/x-jira-token"
      }
    },
    "rk-bitbucket": {
      "command": "node",
      "args": [
        ".gigacode/mcp/bitbucket-mcp/dist/index.js"
      ],
      "env": {
        "BITBUCKET_URL": "https://stash.sigma.sbrf.ru",
        "BITBUCKET_TOKEN": "$secret:rk-bitbucket/BITBUCKET_TOKEN"
      },
      "timeout": 120000,
      "trust": false
    },
    "rk-onework": {
      "httpUrl": "https://mcp.onework.sigma.sbrf.ru/mcp",
      "headers": {
        "Authorization": "$secret:rk-onework/Authorization"
      }
    },
    "rk-email": {
      "command": "node",
      "args": [
        ".gigacode/mcp/mcp-email/dist/index.js"
      ],
      "env": {
        "USER": "<логин Sigma>",
        "PASSWORD": "$secret:rk-email/PASSWORD",
        "SMTP_FROM": "<ваш адрес>@sberbank.ru",
        "LDAP_BIND_DN": "$secret:rk-email/LDAP_BIND_DN",
        "LDAP_BIND_PASSWORD": "$secret:rk-email/LDAP_BIND_PASSWORD"
      },
      "timeout": 60000,
      "trust": false
    }
  },
  "$version": 4
}
