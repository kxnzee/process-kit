# Доступами заведует клиент GigaCode: токенов и файлов с ними в проекте быть не должно
.gigacode/.env
.env
.env.*

# Что GigaCode и IDE пишут в папку проекта сами
.gigacode/tmp/
.gigacode/history/
.gigacode/memory/
.gigacode/cache/
.gigacode/logs/
.gigacode/state/
.gigacode/sessions/
.gigacode/projects/
.gigacode/shell-snapshots/
.gigacode/plugins/
.gigacode-extension-install.json

# IDE и вспомогательные каталоги
.gigaide/
.idea/
.vscode/
.DS_Store
Thumbs.db
# Локальные настройки и несистемные папки с пробелами остаются на этом компьютере
/*.local.json
/* */

# Данные человека: результаты запусков и журнал прогонов в git не попадают
/outputs/
/.history/

# Служебные папки прежних прогонов
.runs/
.run/
# Временные рабочие копии переноса
.gigacode/worktrees/

# Локальные MCP доставляются отдельно: бинарные файлы и зависимости не публикуются
/.gigacode/mcp/
